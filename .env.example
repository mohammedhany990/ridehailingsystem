# PostgreSQL
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

# MongoDB
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password

# Redis
SPRING_DATA_REDIS_PASSWORD=your_redis_password

# JWT
JWT_SECRET=your_base64_encoded_jwt_secret

# Mail (SMTP, used by auth-service for OTP/verification emails)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email_username
SPRING_MAIL_PASSWORD=your_email_password_or_app_password

# Stripe test mode (leave STRIPE_ENABLED=false or the keys empty to run payments in simulated mode)
# 1. dashboard.stripe.com -> Developers -> API keys: copy the test Secret key and Publishable key
# 2. dashboard.stripe.com -> Developers -> Webhooks -> Add endpoint:
#    URL https://<your-host>/api/payments/webhook, events payment_intent.succeeded / payment_failed / canceled
#    then copy the endpoint's Signing secret
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth (Google sign-in ID token flow; leave empty to disable the Google button)
# Create an OAuth 2.0 Client ID in Google Cloud Console; see README for the steps.
GOOGLE_CLIENT_ID=